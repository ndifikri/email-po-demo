# Salin file ini menjadi .streamlit/secrets.toml lalu isi nilainya.
# JANGAN commit secrets.toml.

[openai]
api_key = "sk-..."
model = "gpt-6-luna"

[google_oauth]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "..."
project_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
# Lokal: "http://localhost:8501" · Streamlit Cloud: "https://<nama-app>.streamlit.app"
redirect_uri = "http://localhost:8501"

# Login admin aplikasi. Isi password asli hanya di secrets.toml / Streamlit Cloud.
[auth]
username = "admin"
password = "ganti-dengan-password-kuat"

[app]
poll_interval_seconds = 15
max_emails_per_cycle = 20
confidence_threshold = 0.6
max_body_chars = 12000
